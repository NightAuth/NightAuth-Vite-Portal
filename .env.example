# URL of your NightAuth instance (the dev proxy forwards /api/* there).
PUBLIC_NIGHTAUTH_API_URL=https://nightauth.org

# Public customer portal ID of your application
# (Dashboard → Application settings → Customer portal).
PUBLIC_NIGHTAUTH_PORTAL_ID=your_portal_id

# Fallback name shown until the portal settings load.
PUBLIC_NIGHTAUTH_APP_NAME="My App"

# Captcha is automatic: when NightAuth requires it, the widget appears and
# talks to NightAuth's Cap proxy at /api/cap/ on this same origin. Override
# only to call a public Cap instance directly (it must then allow this origin
# in its CORS_ORIGIN).
# PUBLIC_CAP_API_ENDPOINT=https://cap.example.com/<site-key>/

# Never put a Business API key (biz_...) here: every PUBLIC_ variable is
# compiled into the static site and visible to anyone.
